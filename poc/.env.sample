# Neo4j (knowledge graph) connection details
# Default values are shown here, you'll likely have to adjust the username and password
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=Your_Password

## Neo4j Docker for the first time

#    docker run \
#     --name neo4j-community \
#     -p 7474:7474 -p 7687:7687 \
#     -e NEO4J_AUTH=neo4j/Your_Password \
#     -e NEO4J_PLUGINS='["apoc"]' \
#     -v "/home/shrey/projects/LLM/rag&agents/graphiti-agent/database":/data \
#     neo4j:5.26-community

## To start Neo4j

#    docker start neo4j-community

## To see the info in neo4j run this 

# MATCH (a)-[r]-(b)
# RETURN a, r, b